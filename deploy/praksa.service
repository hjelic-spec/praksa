# systemd: aplikacija kao servis (pokreće se s poslužiteljem, ponovno nakon pada).
#   sudo cp deploy/praksa.service /etc/systemd/system/ && sudo systemctl enable --now praksa
[Unit]
Description=Praksa - preglednik sudske prakse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=praksa
WorkingDirectory=/opt/praksa
EnvironmentFile=/etc/praksa.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
# Ograničenja: aplikacija smije pisati samo u svoju podatkovnu mapu.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/praksa

[Install]
WantedBy=multi-user.target
