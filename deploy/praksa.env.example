# Postavke za poslužitelj: kopirajte u /etc/praksa.env (chmod 600, vlasnik root) i upišite vrijednosti.
# Aplikacija sluša samo lokalno; izvana joj se pristupa preko Caddyja (HTTPS).
PRAKSA_HOST=127.0.0.1
PORT=8080
PRAKSA_DATA_DIR=/var/lib/praksa
PRAKSA_PUBLIC_URL=https://praksa.primjer.hr
PRAKSA_TRUST_PROXY=1

# API ključ se može upisati i u Postavkama aplikacije.
ANTHROPIC_API_KEY=

# Zadana mjesečna kvota po korisniku u USD (0 = bez ograničenja); mijenja se i u Postavkama.
PRAKSA_KVOTA_USD=20

# E-pošta za reset lozinke i obavijesti o registraciji (bez nje: administrator postavlja novu lozinku u Korisnici).
# PRAKSA_SMTP_URL=smtps://korisnik:lozinka@smtp.primjer.hr:465
# PRAKSA_MAIL_FROM=Sudska praksa <praksa@primjer.hr>

# Kontakt za operatera odluke.sudovi.hr.
PRAKSA_USER_AGENT=praksa-preglednik/0.2 (kontakt: vas@primjer.hr)
